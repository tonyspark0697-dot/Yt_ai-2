name: Build APK from zip
on: workflow_dispatch
permissions:
  contents: write
jobs:
  apk:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4
      - name: Unzip project
        run: unzip -q yt_ai.zip
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Build APK
        working-directory: yt_ai/android-app
        run: |
          npm install --no-audit --no-fund
          mkdir www && cp -r ../docs/. www/
          npx cap add android
          npx cap sync android
          npx capacitor-assets generate --android --iconBackgroundColor '#0f1115' --iconBackgroundColorDark '#0f1115' || true
          cd android && ./gradlew assembleDebug --no-daemon
      - name: Publish APK
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          cp yt_ai/android-app/android/app/build/outputs/apk/debug/app-debug.apk AutoTube.apk
          gh release delete apk-latest --yes --cleanup-tag 2>/dev/null || true
          gh release create apk-latest AutoTube.apk --title "Auto Tube APK" --notes "Download AutoTube.apk and install it."
